{
  "name": "@downtown65/events",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "ci:generate": "pnpm run generate:react-router-types && pnpm run generate:cf && pnpm run generate:api-types:file",
    "ci:lint": "biome ci",
    "clean": "rimraf node_modules .wrangler .react-router .generated build dist test-results  worker-configuration.d.ts test-results wrangler-pr-jsonc",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "pnpm run generate:local && react-router dev",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "format": "biome format --write .",
    "generate:api-types:file": "openapi-typescript ../api/.generated/openapi.json  -o ./.generated/types/app/api/+types/api.d.ts",
    "generate:api-types:server": "openapi-typescript http://localhost:3002/doc -o ./.generated/types/app/api/+types/api.d.ts",
    "generate:cf": "wrangler types",
    "generate:wrangler-config": "tsx scripts/generate-wrangler-config.ts",
    "generate:local": "wrangler types --config wrangler.local.jsonc && pnpm run generate:react-router-types && pnpm run generate:api-types:server",
    "generate:react-router-types": "react-router typegen",
    "knip": "knip",
    "lint": "biome check",
    "preview": "pnpm run build && vite preview",
    "test": "vitest",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@downtown65/logger": "workspace:*",
    "@downtown65/schema": "workspace:*",
    "@mantine/core": "8.3.14",
    "@mantine/dates": "8.3.14",
    "@mantine/form": "8.3.14",
    "@mantine/hooks": "8.3.14",
    "@mantine/tiptap": "8.3.14",
    "@react-router/fs-routes": "7.13.0",
    "@tabler/icons-react": "3.36.1",
    "@tiptap/extension-link": "3.19.0",
    "@tiptap/pm": "3.19.0",
    "@tiptap/react": "3.19.0",
    "@tiptap/starter-kit": "3.19.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "dayjs": "1.11.19",
    "isbot": "5.1.34",
    "jwt-decode": "catalog:",
    "openapi-fetch": "0.15.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router": "7.13.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@cloudflare/vite-plugin": "1.23.1",
    "@downtown65/wrangler-config": "workspace:*",
    "@playwright/test": "1.58.0",
    "@react-router/dev": "7.13.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "catalog:",
    "@types/react": "19.2.13",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.2.3",
    "jsdom": "27.4.0",
    "knip": "catalog:",
    "openapi-typescript": "7.10.1",
    "postcss": "8.5.6",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "7.3.0",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18",
    "wrangler": "catalog:"
  }
}
