{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dt65-events",
  "compatibility_date": "2025-04-04",
  "main": "./workers/app.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_flags": ["nodejs_compat"],
  "env": {
    "pull-request": {
      "name": "dt65-events-pr-$PR_NUMBER",
      "routes": [
        {
          "pattern": "events.pr-$PR_NUMBER.downtown65.com",
          "custom_domain": true
        }
      ],
      "observability": {
        "enabled": true
      },
      "vars": {
        "API_HOST": "api.pr-$PR_NUMBER.downtown65.com"
      }
    },
    // Production and staging environments
    "staging": {
      "name": "dt65-events-staging",
      "routes": [
        {
          "pattern": "events.staging.downtown65.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "API_HOST": "api.staging.downtown65.com"
      }
    },
    "production": {
      "name": "dt65-events-production",
      "routes": [
        {
          "pattern": "events.downtown65.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "API_HOST": "api.downtown65.com"
      }
    }
  }
}
