{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dt65-events-frontend",
  "compatibility_date": "2025-04-04",
  "main": "./workers/app.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_flags": ["nodejs_compat"],
  "env": {
    "pull-request": {
      "name": "{{VAR_WORKER_NAME}}",
      "routes": [
        {
          "pattern": "{{VAR_WORKER_NAME}}.downtown65.site",
          "custom_domain": true
        }
      ],
      "observability": {
        "enabled": true
      },
      "vars": {
        "API_HOST": "{{VAR_API_HOST}}"
      }
    },
    // Production and staging environments
    "staging": {
      "routes": [
        {
          "pattern": "staging.downtown65.site",
          "custom_domain": true
        }
      ],
      "vars": {
        "API_HOST": "staging-api.downtown65.site"
      }
    },
    "production": {
      "routes": [
        {
          "pattern": "www.downtown65.site",
          "custom_domain": true
        }
      ],
      "vars": {
        "API_HOST": "api.downtown65.site"
      }
    }
  }
}
