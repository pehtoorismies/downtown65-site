{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dt65-api",
  "compatibility_date": "2025-04-04",
  "main": "./src/server.ts",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "workers_dev": false,
  "observability": { "enabled": true },
  "env": {
    "unit-test": {
      "name": "dt65-api-unit-test",
      "vars": {
        "AUTH_CLIENT_ID": "JaoAht7ggce7f5R8DCBGUyjUJeMQEDtz",
        "AUTH_DOMAIN": "dev-dt65.eu.auth0.com",
        "AUTH_AUDIENCE": "https://graphql-dev.downtown65.com",
        "LOG_LEVEL": "silent"
      },
      "d1_databases": [
        {
          "binding": "D1_DB",
          "database_name": "unit-test",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "drizzle_flat"
        }
      ]
    },
    "pull-request": {
      "name": "dt65-api-pr-$PR_NUMBER",
      "preview_urls": false,
      "workers_dev": false,
      "routes": [
        { "custom_domain": true, "pattern": "api-pr-$PR_NUMBER.downtown65.com" }
      ],
      "d1_databases": [
        {
          "binding": "D1_DB",
          "database_id": "$PR_DATABASE_ID",
          "database_name": "pr-$PR_NUMBER-dt65-events",
          "migrations_dir": "drizzle_flat"
        }
      ],
      "vars": {
        "AUTH_AUDIENCE": "https://graphql-dev.downtown65.com",
        "AUTH_CLIENT_ID": "JaoAht7ggce7f5R8DCBGUyjUJeMQEDtz",
        "AUTH_DOMAIN": "dev-dt65.eu.auth0.com",
        "LOG_LEVEL": "info"
      }
    },
    "staging": {
      "name": "dt65-api-staging",
      "routes": [
        { "pattern": "api-staging.downtown65.com", "custom_domain": true }
      ],
      "vars": {
        "AUTH_CLIENT_ID": "uPu5NUyP1yaGw2IAC0B1KeCgbX3FaNzz",
        "AUTH_DOMAIN": "prod-dt65.eu.auth0.com",
        "AUTH_AUDIENCE": "https://graphql-api.downtown65.com/",
        "LOG_LEVEL": "warn"
      },
      "d1_databases": [
        {
          "binding": "D1_DB",
          "database_name": "staging-dt65-events",
          "database_id": "554a46eb-7563-4511-950c-32c6e29140a5",
          "migrations_dir": "drizzle_flat"
        }
      ]
    },
    "production": {
      "name": "dt65-api-production",
      "routes": [{ "pattern": "api.downtown65.com", "custom_domain": true }],
      "vars": {
        "AUTH_CLIENT_ID": "uPu5NUyP1yaGw2IAC0B1KeCgbX3FaNzz",
        "AUTH_DOMAIN": "prod-dt65.eu.auth0.com",
        "AUTH_AUDIENCE": "https://graphql-api.downtown65.com/",
        "LOG_LEVEL": "info"
      },
      "d1_databases": [
        {
          "binding": "D1_DB",
          "database_name": "production-dt65-events",
          "database_id": "3c2389cc-3e40-421b-8e5c-57348c24056a",
          "migrations_dir": "drizzle_flat"
        }
      ]
    }
  }
}
