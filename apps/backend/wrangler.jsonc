{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api-dt65-events",
  "compatibility_date": "2025-04-04",
  "main": "./src/server.ts",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "workers_dev": false,
  "env": {
    // CI/CD environments
    "pull-request": {
      "name": "$PR_NUMBER-api-dt65-events",
      "routes": [
        {
          "pattern": "$PR_NUMBER-api.downtown65.site",
          "custom_domain": true
        }
      ],
      "observability": {
        "enabled": true
      },
      "vars": {
        "AUTH_CLIENT_ID": "JaoAht7ggce7f5R8DCBGUyjUJeMQEDtz",
        "AUTH_DOMAIN": "dev-dt65.eu.auth0.com",
        "AUTH_AUDIENCE": "https://graphql-dev.downtown65.com"
      },
      "d1_databases": [
        {
          "binding": "D1_DB",
          "database_name": "$PR_NUMBER-dt65-events",
          "database_id": "$DATABASE_ID_PR",
          "migrations_dir": "drizzle_flat"
        }
      ]
    },
    // Production and staging environments
    "staging": {
      "routes": [
        {
          "pattern": "staging-api.downtown65.site",
          "custom_domain": true
        }
      ],
      "vars": {
        "AUTH_CLIENT_ID": "uPu5NUyP1yaGw2IAC0B1KeCgbX3FaNzz",
        "AUTH_DOMAIN": "prod-dt65.eu.auth0.com",
        "AUTH_AUDIENCE": "https://graphql-api.downtown65.com/"
      },
      "observability": {
        "enabled": true
      },
      "d1_databases": [
        {
          "binding": "D1_DB",
          "database_name": "staging-dt65-events",
          "database_id": "554a46eb-7563-4511-950c-32c6e29140a5",
          "migrations_dir": "drizzle_flat"
        }
      ]
    },
    "production": {
      "routes": [
        {
          "pattern": "api.downtown65.site",
          "custom_domain": true
        }
      ],
      "vars": {
        "AUTH_CLIENT_ID": "uPu5NUyP1yaGw2IAC0B1KeCgbX3FaNzz",
        "AUTH_DOMAIN": "prod-dt65.eu.auth0.com",
        "AUTH_AUDIENCE": "https://graphql-api.downtown65.com/"
      },
      "observability": {
        "enabled": true
      },
      "d1_databases": [
        {
          "binding": "D1_DB",
          "database_name": "production-dt65-events",
          "database_id": "3c2389cc-3e40-421b-8e5c-57348c24056a",
          "migrations_dir": "drizzle_flat"
        }
      ]
    }
  }
}
